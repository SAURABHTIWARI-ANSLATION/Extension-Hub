{
  "manifest_version": 3,
  "name": "ExtensionVault: CRX & ZIP Downloader",
  "short_name": "ExtensionVault",
  "version": "1.1.0",
  "description": "Download any Chrome Web Store extension as a .CRX or .ZIP file. Privacy-focused, open-source, and zero tracking.",
  "author": "ExtensionVault Contributors",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "ExtensionVault – CRX & ZIP Downloader"
  },
  "background": {
    "service_worker": "js/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chromewebstore.google.com/*",
        "https://chrome.google.com/webstore/*"
      ],
      "js": [
        "js/content.js"
      ],
      "css": [
        "css/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://clients2.google.com/*",
    "https://clients2.googleusercontent.com/*",
    "https://chromewebstore.google.com/*",
    "https://chrome.google.com/webstore/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://clients2.google.com https://clients2.googleusercontent.com https://chromewebstore.google.com https://chrome.google.com; object-src 'none';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "html/offscreen.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}